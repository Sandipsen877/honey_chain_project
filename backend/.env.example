# Server
PORT=5000
PUBLIC_BASE_URL=localhost:5000

# MongoDB
MONGO_URI=***

# ML Service (FastAPI). If unset or unreachable, mlService.js falls back
# to a simple internal heuristic so the demo still works without it.
ML_SERVICE_URL=http://localhost:8000
VARROA_PREDICT_URL=***

# Auth
JWT_SECRET=***
JWT_EXPIRES_IN=30d
# OTP is mocked (logged to console) since there's no SMS gateway yet.
OTP_EXPIRES_MINUTES=5

# Sensor simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_CRON=*/2 * * * *

# Cloudinary (image storage for Varroa detections)
CLOUDINARY_CLOUD_NAME=***
CLOUDINARY_API_KEY=***
CLOUDINARY_API_SECRET=***

# KVIC admin dashboard
KVIC_ADMIN_INVITE_CODE=***
