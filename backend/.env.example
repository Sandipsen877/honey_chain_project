# Server
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/beekeeping_prototype

# ML Service (FastAPI health/Varroa service). Required by POST /api/alerts/predict.
# Start ml_service first, then use its base URL. Do not include a trailing slash.
ML_SERVICE_URL=http://localhost:8000

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d
# OTP is mocked (logged to console) since there's no SMS gateway yet.
OTP_EXPIRES_MINUTES=5

# Sensor simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_CRON=*/2 * * * *
